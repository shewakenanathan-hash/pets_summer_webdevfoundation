(root / "Routes/pets.js").write_text(r'''const express = require("express");
const fs = require("fs");
const path = require("path");

const router = express.Router();

const dataDir = path.join(__dirname, "..", "data");
const petsFile = path.join(dataDir, "pets.json");

function ensureFile() {
  if (!fs.existsSync(dataDir)) fs.mkdirSync(dataDir, { recursive: true });
  if (!fs.existsSync(petsFile)) fs.writeFileSync(petsFile, "[]", "utf8");
}

function readPets() {
  ensureFile();
  try {
    const pets = JSON.parse(fs.readFileSync(petsFile, "utf8"));
    return Array.isArray(pets) ? pets : [];
  } catch {
    return [];
  }
}

function writePets(pets) {
  ensureFile();
  fs.writeFileSync(petsFile, JSON.stringify(pets, null, 2), "utf8");
}

function nextId(pets) {
  return pets.length ? Math.max(...pets.map(p => Number(p.id) || 0)) + 1 : 1;
}

// GET /api/pets
router.get("/", (req, res) => {
  let pets = readPets();
  const search = String(req.query.search || "").trim().toLowerCase();

  if (search) {
    pets = pets.filter(pet =>
      Object.values(pet).some(value =>
        String(value).toLowerCase().includes(search)
      )
    );
  }

  res.json(pets);
});

// GET /api/pets/:id
router.get("/:id", (req, res) => {
  const pet = readPets().find(p => String(p.id) === String(req.params.id));

  if (!pet) return res.status(404).json({ error: "Pet not found" });

  res.json(pet);
});

// POST /api/pets
router.post("/", (req, res) => {
  const pets = readPets();
  const body = req.body || {};

  if (!body.name) {
    return res.status(400).json({ error: "Pet name is required" });
  }

  const pet = {
    id: nextId(pets),
    name: body.name,
    type: body.type || "Other",
    breed: body.breed || "",
    age: body.age || "",
    gender: body.gender || "",
    location: body.location || "",
    description: body.description || "",
    image: body.image || "",
    status: body.status || "Available",
    createdAt: new Date().toISOString()
  };

  pets.push(pet);
  writePets(pets);
  res.status(201).json(pet);
});

// PUT /api/pets/:id
router.put("/:id", (req, res) => {
  const pets = readPets();
  const index = pets.findIndex(p => String(p.id) === String(req.params.id));

  if (index === -1) {
    return res.status(404).json({ error: "Pet not found" });
  }

  pets[index] = {
    ...pets[index],
    ...req.body,
    id: pets[index].id,
    updatedAt: new Date().toISOString()
  };

  writePets(pets);
  res.json(pets[index]);
});

// DELETE /api/pets/:id
router.delete("/:id", (req, res) => {
  const pets = readPets();
  const index = pets.findIndex(p => String(p.id) === String(req.params.id));

  if (index === -1) {
    return res.status(404).json({ error: "Pet not found" });
  }

  const deleted = pets.splice(index, 1)[0];
  writePets(pets);

  res.json({ message: "Pet deleted successfully", pet: deleted });
});

module.exports = router;
''')

